//ファイル "default.json" は、一部を "user.json" にコピーして使うためのものです。
//実際の設定としては読み込まれません。読み込まれるのは "user.json" です。
//
//一部のオプションには OS ごとの接尾辞があります:
//  Windows: なし
//  Linux: "__linux"
//  macOS: "__mac"
//  FreeBSD: "__freebsd"
//  OpenBSD: "__openbsd"
//  NetBSD: "__netbsd"
//  DragonFlyBSD: "__dragonfly"
//  Solaris: "__solaris"
//  Haiku: "__haiku"
{
  //[Font]
  //テキストのフォント名. [has suffix]
  "font_name": "Consolas",
  "font_name__linux": "Courier New",
  "font_name__mac": "Monaco",

  //イタリック部分用のテキストのフォント名. [has suffix]
  //空文字列も指定できます。
  //注意: このオプションはプロポーショナルフォントを十分にサポートしません。
  "font_name_i": "",
  "font_name_i__linux": "",
  "font_name_i__mac": "",

  //太字部分用のテキストのフォント名. [has suffix]
  //空文字列も指定できます。
  //注意: このオプションはプロポーショナルフォントを十分にサポートしません。
  "font_name_b": "",
  "font_name_b__linux": "",
  "font_name_b__mac": "",

  //太字+イタリック部分用のテキストのフォント名. [has suffix]
  //空文字列も指定できます。
  //注意: このオプションはプロポーショナルフォントを十分にサポートしません。
  "font_name_bi": "",
  "font_name_bi__linux": "",
  "font_name_bi__mac": "",

  //テキストのフォントサイズ. [has suffix]
  "font_size": 10,
  "font_size__linux": 10,
  "font_size__mac": 10,

  //イタリック部分用のテキストのフォントサイズ. [has suffix]
  "font_size_i": 10,
  "font_size_i__linux": 10,
  "font_size_i__mac": 10,

  //太字部分用のテキストのフォントサイズ. [has suffix]
  "font_size_b": 10,
  "font_size_b__linux": 10,
  "font_size_b__mac": 10,

  //太字+イタリック部分用のテキストのフォントサイズ. [has suffix]
  "font_size_bi": 10,
  "font_size_bi__linux": 10,
  "font_size_bi__mac": 10,

  //フォントのリガチャを描画します (例: フォント "Fira Code")。
  //このオプションは Windows でのみ有効です。
  //他の OS ではリガチャは有効です (ウィジェットセットに依存します。例: GTK2/Qt5)。
  "font_ligatures": true,

  //テキストのフォント描画品質. [has suffix]
  //  0: 既定
  //  1: ドラフト
  //  2: プルーフ
  //  3: アンチエイリアスなし
  //  4: アンチエイリアスあり
  //  5: ClearType
  //  6: ClearType Natural
  "font_quality": 0,
  "font_quality__linux": 0,
  "font_quality__mac": 0,

  //UI 要素のフォント名. [has suffix]
  "ui_font_name": "default",
  "ui_font_name__linux": "default",
  "ui_font_name__mac": "default",

  //UI 要素のフォントサイズ. [has suffix]
  "ui_font_size": 9,
  "ui_font_size__linux": 9,
  "ui_font_size__mac": 9,

  //出力パネルのフォント名. [has suffix]
  "ui_font_output_name" : "default",
  "ui_font_output_name__linux" : "default",
  "ui_font_output_name__mac" : "default",

  //出力パネルのフォントサイズ. [has suffix]
  "ui_font_output_size" : 9,
  "ui_font_output_size__linux" : 9,
  "ui_font_output_size__mac" : 9,

  //ステータスバーのフォント名. [has suffix]
  //空の場合は "ui_font_name" の値を使用します。
  "ui_font_statusbar_name" : "",
  "ui_font_statusbar_name__linux" : "",
  "ui_font_statusbar_name__mac" : "",

  //ステータスバーのフォントサイズ. [has suffix]
  //0 の場合は "ui_font_size" の値を使用します。
  "ui_font_statusbar_size" : 0,
  "ui_font_statusbar_size__linux" : 0,
  "ui_font_statusbar_size__mac" : 0,

  //[Renderer]
  //編集時のちらつきを減らすための遅延を指定します. [has suffix]
  //値 0: 機能は無効です。
  //値 1...999: タイマーの遅延 (ミリ秒) です。低速なシステムでは 15...40 程度が適切です。
  //値 1000: 専用のちらつき防止コードを使用します。システムによってはこちらの方が良好に動作します。
  "renderer_anti_flicker": 0,
  "renderer_anti_flicker__linux": 0,
  "renderer_anti_flicker__mac": 0,

  //テキスト描画の各種オプション. [has suffix]
  //値は複数の文字からなる文字列です:
  //  値に 'w' を含む場合: 平均文字幅の簡易計算を使用します。
  //                   Windows では 'w' が適しています。
  //                   macOS では 'w' は不適です。
  //                   GTK2 では 'w' は不要です。
  //                   Qt5 では 'w' の結果は一定せず、デスクトップ環境に依存します。
  //  値に 'o' を含む場合: 個々の文字の 'offsets' を計算します (低速な API で描画します)。
  //                   Windows では 'offsets' で描画速度は低下しません。
  //                   macOS では 'offsets' により描画速度が低下します (2倍遅くなります)。
  //                   GTK2 と Qt5 では 'offsets' により描画速度が低下します。
  //  値に 'c' を含む場合: カーソルの描画時に、反転したカーソルのセルの上にもテキストを描画します。
  //  値に 's' を含む場合: Unicode の空白文字を通常の空白として表示します。
  //                   's' を含まない場合は、Unicode の空白文字を16進形式で表示します。
  //                   Unicode の空白文字: U+1680, U+2007, U+200B, U+202F, U+205F, U+2060, U+3000。
  //  値に 'l' を含む場合: Windows で、カーソルのある行のリガチャを有効にします。
  //  値に 'n' を含む場合: 行末が選択されているとき、行末の空セルを描画しません。
  //  値に 'W' を含む場合: エディターの右端に折り返し行のマークを描画します。
  //
  //注意: Qt5/Qt6 版の既定値は GTK 版と異なり、macOS の既定値と同じです。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "renderer_tweaks": "wos",
  "renderer_tweaks__linux": "ws",
  "renderer_tweaks__mac": "s",

  //Unicode 文字の幅をフォントに比例させます。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "unicode_proportional": true,

  //"Insert Pics" プラグインが挿入する行間ビットマップの水平方向の配置。
  //  -2: 右揃え
  //  -1: 中央揃え
  //  0...50: 左揃え (指定したインデント付き、単位は平均文字幅)
  "gap_bitmap_align": -1,

  //[UI]
  //エディターコントロールとその他の GUI コントロールのダブルバッファリング. [has suffix]
  //描画に問題がある場合に使用します:
  //a) ちらつきが出る場合は true にします。
  //b) 高 DPI モニターでテキストがぼやける場合は false にします。
  //また、Windows/Linux ではこのオプションをオフにすると、メモリ使用量を減らせます
  //(ビットマップバッファは、2500x2000 のような大きなウィンドウサイズでは
  //UI タブ 1 つあたり約 10 MB を使用します)。
  "ui_buffered": true,
  "ui_buffered__linux": true,
  "ui_buffered__mac": false,

  //CudaText のインスタンス (メインウィンドウ) を 1 つだけ実行できるようにします。
  "ui_one_instance": true,

  //メインウィンドウのタスクバーでの表示方法. [has suffix]
  //オン (既定) の場合: アプリは Windows 標準のアニメーションで最小化/復元されます。
  //   ただし、Windows の Alt+Tab に、開いているダイアログ用の項目が追加表示されます。
  //オフの場合: Alt+Tab にダイアログ用の項目は追加表示されず、便利です。
  "ui_taskbar_mode": true,
  "ui_taskbar_mode__linux": true,
  "ui_taskbar_mode__mac": true,

  //プラグインのダイアログを個別のタスクバーボタンで表示します. [has suffix]
  //注意: Linux のデスクトップ環境 Cinnamon では、'false' にすると問題が発生します。
  "ui_dialogs_in_taskbar": false,
  "ui_dialogs_in_taskbar__linux": true,
  "ui_dialogs_in_taskbar__mac": true,

  //ハイパーリンクをダブルクリックしたとき、クリックした位置の上に
  //確認ボタンを追加表示します。
  "ui_links_confirm": true,

  //マウスオーバー時にテーマ付きボタンを着色します。
  "ui_button_hover": false,

  //[File/Notifications]
  //外部プログラムによるファイル変更の通知:
  //通知を有効にします (外部プログラムによるファイル変更を監視する
  //スレッドを有効にします)。
  //"true" に変更するにはアプリの再起動が必要です。
  "ui_notif": true,

  //外部プログラムによるファイル変更の通知:
  //監視スレッドの待機時間 (秒)。
  "ui_notif_time": 2,

  //外部プログラムによるファイル変更の通知:
  //変更されたファイルを再読み込みする確認を、いつ/どのように表示するか。
  //  0: モードレスのプロンプトを常に表示 (外部プログラムで変更されるたび)
  //  1: モードレスのプロンプトを表示 (エディターが変更済み、または Undo データが空でない場合)
  //  2: モードレスのプロンプトを表示 (エディターが変更済みの場合)
  //  3: モーダルのプロンプトを常に表示
  //  4: モーダルのプロンプトを表示 (エディターが変更済みの場合)
  "ui_notif_confirm": 0,

  //[File/Detection]
  //テキスト以外のファイル: そのようなファイルを開くときの動作。
  //  0: 選択肢付きの確認を表示
  //  1: エディターで自動的に開く
  //  2: 開かない
  //  3: ビューアーのバイナリモードで自動的に開く
  //  4: ビューアーの16進モードで自動的に開く
  "ui_non_text": 0,

  //テキスト以外のファイル: 判定用バッファサイズ (KB)。
  "ui_non_text_buffer": 64,

  //自動判別に失敗したときに使用するエンコード。
  //対応するエンコード名のいずれか、または特別な値 "ansi", "oem" のいずれか。
  //値 "ansi" は OS 依存の ANSI エンコードを意味します:
  //cp1250, cp1251, cp1252, cp1253, cp1254, cp1255, cp1256, cp1257, cp1258,
  //cp874, shift-jis, gbk, uhc, big5.
  //値 "oem" は OS 依存の OEM エンコードを意味します: cp437, cp850, cp852, cp866,
  //cp874, shift-jis, gbk, uhc, big5.
  //UTF-8 / UTF-16 / UTF-32 系は指定できません。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "fallback_encoding": "ansi",

  //[File]
  //ファイルの再読み込み: カーソルが最終行にあった場合、再読み込み後は新しい最終行にカーソルを置きます。
  "ui_reload_tail": true,

  //ファイルの手動での再オープン/再読み込み: タブに未保存の変更がある場合は、再読み込みの確認を表示します。
  "ui_reload_unsaved_confirm": true,

  //コマンド "File / Save" を、ドキュメントが未変更の状態でも常に実行できるようにします。
  //オフの場合、コマンドは変更済みのドキュメント、またはファイルが外部で削除された場合にのみ動作します。
  "ui_save_always": true,

  //[Text/Look]
  //各行の追加の縦方向の間隔 (ピクセル). [has suffix]
  //負の値も指定できます。
  "line_space_top": 0,
  "line_space_top__linux": 0,
  "line_space_top__mac": 0,

  "line_space_bottom": 1,
  "line_space_bottom__linux": 1,
  "line_space_bottom__mac": 1,

  //選択範囲内のテキストの元のフォント色を維持します。
  "keep_sel_font_color": false,

  //カーソルのある行の背景を強調表示します。
  "show_cur_line": false,

  //カーソルのある行の背景を強調表示: 行が折り返されている場合は、行の最小限の部分のみ。
  "show_cur_line_minimal": true,

  //カーソルのある行の背景を強調表示: フォーカスのあるエディターのみ。
  "show_cur_line_only_focused": false,

  //折り返された長い行のインデント部分に縦の点線を表示します。
  "show_indent_lines": true,

  //最終行をウィンドウの上端までスクロールできるようにします。
  "show_last_line_on_top": false,

  //選択範囲の背景をウィンドウの右端まで強調表示します
  //(オフの場合: 行末まで)。
  "show_full_sel_bg": false,

  //構文で定義されたブロックの背景をウィンドウの右端まで強調表示します
  //(オフの場合: 行末まで)。
  "show_full_syntax_bg": true,

  //テキスト領域を右にずらし、テキストが "中央寄せ" に見えるようにします。
  //  値=0: ずらしません。
  //  値>0: テキスト領域をずらし、行の先頭 N 文字が "中央寄せ" に見えるようにします。
  //注意: 小さい値は設定せず、80 以上のような大きめの値を使用してください。
  "centering_width": 0,

  //"centering_width" と同じですが、集中モードで適用されます。
  //注意: 小さい値は設定せず、80 以上のような大きめの値を使用してください。
  "centering_for_distraction_free": 0,

  //ゼブラモード: N 行おきに追加で着色します (既定は N=2)。
  //  値=0: ゼブラモードは無効です。
  //  値=1...255: 新しい色のアルファブレンド値を指定します。220..245 が最適です。
  "zebra": 0,

  //ゼブラモード: 間隔 (行数)。
  "zebra_step": 2,

  //フォーカスのないエディター (非アクティブなタブグループ内) の背景色を暗くします。
  //値: 0: 使用しない; 1...250: 黒とブレンド; -1...-250: 白とブレンド。
  "dim_unfocused": 0,

  //[Lexers]
  //'dynamic highlight' を有効にするドキュメントの最大行数。
  //値 0: 機能は無効です。
  //Wiki のトピック "Dynamic highlight" の説明を参照してください。
  "dynamic_highlight": 4000,

  //ドキュメントの行数がこのオプションの値を超えると、Lexer パーサーは
  //折りたたみ範囲を検出しなくなります。つまり、そのような大きなファイルでは:
  //1) Lexer の解析が 1.5-3 倍速くなります。
  //2) コードツリーが無効になります。
  //3) コードツリーヘルパー (Python と Pascal で記述) が無効になります。
  //したがって、このオプションを極端な値 0 にすると、事実上、折りたたみが無効になり、
  //Lexer の解析が高速化され、メモリ使用量も減ります。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "lexer_folding_max_lines": 15000,

  //[Text/Folding]
  //折りたたまれたブロックのスタイル。
  //  0: 折りたたみヒントが空の場合: 折りたたみ位置から [...]、そうでなければヒント
  //  1: 折りたたみヒントが空の場合: 折りたたみ位置から [line...]、そうでなければヒント
  //  2: 折りたたみヒントが空の場合: 行の後ろに [...]、そうでなければヒント
  //  3: 常に行の後ろに [...]
  //  4: テキスト行の下に水平線
  "fold_style": 1,

  //折りたたまれたブロックの [...] にマウスを重ねたときにツールチップを表示します。
  "fold_tooltip_show": false,

  //折りたたみ範囲が小さすぎる場合、範囲の高さ (行数) が
  //オプションの値以下のときは、折りたたみの +/- アイコンを表示しません。
  //値=0: すべての範囲で表示します。
  "fold_icon_min_range": 0,

  //オプション "fold_style":4 での折りたたみブロックの下線の描画方法。
  //  0: 左端からウィンドウの右端まで
  //  1: 左端から行末まで
  //  2: 行のインデントから行末まで
  //  3: 左端から "margin" 列まで
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "fold_underline_size": 0,

  //[Text/Commands]
  //選択がない場合、"Copy to clipboard" はカーソルのある行全体を対象にします。
  "copy_line_if_no_sel": true,

  //選択がない場合、"Cut to clipboard" はカーソルのある行全体を対象にします。
  "cut_line_if_no_sel": false,

  //縦 (列) 選択がある場合、スペースで揃えてクリップボードにコピーします。
  //つまり、各行をスペースで埋めて同じ長さにします。
  "copy_column_aligned_by_spaces": true,

  //文字を入力したとき、先に選択範囲を削除します。
  "ovr_sel": true,

  //"Insert/Overwrite" モード (Ins キーで切り替え) が "overwrite" のとき、貼り付けたテキスト
  //(Ctrl+V) がエディターのテキストを上書きします。つまり、貼り付け時にも "Overwrite" を尊重します。
  "ovr_on_paste": false,

  //クリップボードのテキストが改行で終わり、選択範囲がない場合、
  //貼り付けコマンド (Ctrl+V) はカーソルの列を無視して、ブロックを行頭に配置します。
  "paste_multiline_at_line_start": false,

  //選択範囲が変わった後に、選択テキストをクリップボードへ自動コピーする設定。
  //このオプションは、UI タブのエディターだけでなく、すべてのエディター欄で有効です。
  //値は数文字からなる文字列です。
  //  値に 'c' を含む場合: 通常のクリップボードにコピーします (Windows では唯一の方法)。
  //  値に 'p' を含む場合: Unix の 'primary selection' にコピーします。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "auto_copy_clp": "",

  //選択テキストのクリップボードへの自動コピー: 対象とする選択範囲の最大長 (バイト)。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "auto_copy_max_size": 500000,

  //[File/Saving]
  //ファイル保存時: 行末の空白を削除します。
  "saving_trim_spaces": false,

  //ファイル保存時: ファイル末尾の余分な空行を削除します。
  "saving_trim_final_empty": false,

  //ファイル保存時: ファイル末尾に改行文字がなければ追加します。
  "saving_force_final_eol": false,

  //[Text]
  //単語の境界を定義する、単語以外の文字の文字列。
  //アンダースコア "_" をここに指定するときは、先頭の文字にしてください。
  //このオプションは Lexer 別の設定で使用してください。
  "nonword_chars": "-+*=/\\()[]{}<>\"'.,:;~?!@#$%^&|`…«»",

  //[Text/Tabulations]
  //タブ文字の幅。
  "tab_size": 4,

  //Tab キーでタブ文字の代わりにスペースを挿入します。
  "tab_spaces": false,

  //Tab キーが、多くのエディターにある "スマートタブ" の動作をします。
  //例: Lazarus IDE にも同様のオプションがあります。Lazarus IDE Wiki の説明:
  //  Tab キーは、直前の行の次の単語の開始位置の真下へ進みます。
  //  直前の行の最後の単語の下にいる場合は、
  //  直前の行の末尾の真下へ移動します。直前の行の最後の単語より後ろにいる場合は、
  //  それより上にある、現在の行より長い行を基準にします。
  //  (以上、Lazarus IDE Wiki の説明より)
  //"スマートタブ" は複数カーソルに対応していますが、選択範囲がない場合のみで、
  //すべてのカーソルの移動は最初のカーソルと同じになります。
  "tab_smart": false,

  //[Text]
  //Undo が機能する最大の行長。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "max_line_len_for_undo": 10000000,

  //行を編集しても、現在の Lexer を 'none' にリセットしない最大の行長
  //(リセットされない期間は数秒)。例えば Intel Core i3 の CPU では、適切な値は 1900 です
  //(それより長い行では、開発者はカーソル描画の不具合を確認しています)。
  //この遅延は "py_change_slow" オプションで制御されます。
  //値 0 (または大きすぎる値): 機能は無効です。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "max_line_len_for_editing_keeping_lexer": 2000,

  //'対応する括弧' の検索処理を行う最大の行長。
  "max_line_len_brackets": 10000,

  //マクロ {offset_max} と {offset_caret} をステータスバーに表示するために、
  //アプリが計算できるドキュメントの最大行数。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "max_lines_to_calc_offsets": 7000,

  //[Lexers]
  //"lite" Lexer が解析する最大の行長。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "max_line_len_parsed": 4000,

  //[View/Gutter]
  //ガター: false の場合、ガターの列がすべて非表示になります (ブックマーク、折りたたみ、行番号、行の状態)。
  "gutter_show": true,

  //ガター: false の場合、折りたたみの線はマウスが離れると自動的に非表示になります。
  "gutter_fold_always": true,

  //ガター: 折りたたみアイコンのスタイル。
  //  0: プラス/マイナス
  //  1: 三角形
  "gutter_fold_icons": 0,

  //ガター: プラス/マイナス/三角形の折りたたみアイコンのサイズ。
  //注意: 大きな値を設定してアイコンが収まらない場合は、"gutter_width_folding" オプションを調整してください。
  "gutter_icon_size": 4,

  //ガター: "folding" 列の幅 (ピクセル)。0 の場合、列は非表示です。
  "gutter_width_folding": 14,

  //ガター: "bookmarks" 列の幅 (ピクセル)。0 の場合、列は非表示です。
  "gutter_width_bookmarks": 16,

  //ガター: "line states" 列の幅 (ピクセル)。0 の場合、列は非表示です。
  "gutter_width_states": 3,

  //ガター: "empty indent" 列の幅 (ピクセル)。0 の場合、列は非表示です。
  "gutter_width_empty": 2,

  //ガター: 対応する括弧の装飾を表示します。
  "gutter_brackets": true,

  //ブックマーク: 行が削除されたとき、ブックマークも自動的に削除します。
  //オフの場合は、ブックマークを上にずらすだけです。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "auto_delete_bookmarks": false,

  //[View/LineNumbers]
  //ガターの "Line numbers" 列を表示します。
  "numbers_show": true,

  //行番号を表示する行。
  //  0: すべての行に表示
  //  1: 表示しない
  //  2: 10行ごとに表示
  //  3: 5行ごとに表示
  //  4: 相対行番号を表示 (最初のカーソルは実際の行番号、他の行はそこからの差分)
  "numbers_style": 0,

  //カーソルのある行には常に行番号を表示します。
  "numbers_for_carets": false,

  //行番号をガター列の中央に配置します。
  "numbers_center": true,

  //[View/Scrolling]
  //縦スクロールバーをドラッグしているとき、右上に行番号のツールチップを表示します。
  "show_hint_on_vert_scroll": false,

  //ピクセル単位のスムーズスクロールを使用します。オフの場合は行単位でスクロールします。
  "smooth_scroll": true,

  //エディターの横スクロールバーの表示。
  //  0: 常に非表示
  //  1: 常に表示
  //  2: 自動表示
  //注意: "scrollbar_themed":true の場合のみ有効です。
  "scroll_style_horz": 2,

  //エディター / コードツリー / プロジェクトマネージャーなどで、
  //OS 標準ではなく独自に描画するスクロールバーを使用します。
  //変更にはアプリの再起動が必要です。
  "scrollbar_themed": true,

  //(アプリのテーマが適用される) スクロールバーの幅 (UI スケーリング適用前)。
  "scrollbar_size": 14,

  //エディターのテーマ付きスクロールバーの矢印のスタイル。
  //値は "," 区切りの 2 つの数値で、横スクロールバー/縦スクロールバーの順です。
  //数値: 0: 矢印を通常の位置に表示; 1: 両方を下に表示; 2: 両方を上に表示; 3: 矢印を非表示。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "scrollbar_arrows": "0,0",

  //スクロールバーの "page up"/"page down" 領域をクリックしたとき、
  //クリックした位置へ直接ジャンプします。オフの場合は、
  //それらの領域をクリックすると "page up"/"page down" のスクロールになります。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "scrollbar_click_jump": false,

  //[Text/Look]
  //マーカーのサイズ (Wiki のトピック "Markers" を参照)、行の高さに対する %。
  "marker_size": 30,

  //ブロックステープル (インデントガイド) のスタイル。
  //  0: 表示しない
  //  1: 通常の線
  //  2: 破線/点線
  //  3: 2ピクセルの線
  //  4: 点線
  "staples_style": 1,

  //ブロックステープルのプロパティ。値は "," 区切りのオプションを含む文字列です:
  //- ステープルの右へのずれ (-5..5、0: ステープルはテキストセルの左端付近)。
  //- ステープルの斜めの辺の幅 (%) (0..200)。
  //- ステープル上端の種類 (列挙)。0: なし; 1: 斜め; 2: 単純な線。
  //- ステープル下端の種類。
  "staples_props": "0,40,0,0",

  //[View/Ruler]
  //ルーラー: ルーラー (上部の横バー) を表示します。
  "ruler_show": false,

  //ルーラー: 高さ (平均的なテキストセルに対する %)。
  "ruler_height": 100,

  //ルーラー: 番号の付け方。
  //  0: 数字 0 - 10 - 20 - 30...
  //  1: 数字 1 - 11 - 21 - 31...
  //  2: 数字 1 - 10 - 20 - 30...
  "ruler_numeration": 0,

  //ルーラー: カーソルのマークのサイズ (ピクセル)、0: マークを非表示。
  "ruler_mark_caret": 1,

  //[View/Minimap]
  //ミニマップ: ミニマップを表示します。
  "minimap_show": false,

  //ミニマップ: 構文ハイライトの計算に許可する時間 (ミリ秒)。
  //この時間を過ぎると、下側の残りの行はハイライトされなくなります。
  //値 0 にすると、ミニマップの構文ハイライトが完全に無効になります。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "minimap_coloring_time": 40,

  //ミニマップ: 選択領域を常に表示します。false の場合はマウスオーバー時のみ表示します。
  "minimap_sel_always": false,

  //ミニマップ: 選択領域の周囲に 1 ピクセルの枠線を表示します。
  "minimap_sel_border": true,

  //ミニマップ: ミニマップ領域の幅。
  //  値=0: ミニマップは現在のウィンドウ幅とガター幅に応じて自動でサイズが決まります
  //  値>0: ミニマップは指定した固定幅になります (平均文字セル単位)
  "minimap_char_width": 0,

  //ミニマップ: ミニマップを左側に配置します。
  "minimap_at_left": false,

  //ミニマップ: 拡大率 (%)。
  //  値=0: 既定の表示 (1 行あたり 2 ピクセル) を使用し、"ui_scale" を考慮します。
  //  0<値<100: コンパクト表示 (1 行あたり 1 ピクセル) を使用し、"ui_scale" を無視します。
  //  値>=100: 指定した行の高さ (%) を使用し、"ui_scale" を考慮します。
  "minimap_scale": 0,

  //ミニマップ: マウスカーソルがミニマップ上に来たとき、"ツールチップパネル" を表示します。
  "minimap_tooltip_show": false,

  //ミニマップ: "ツールチップパネル" の高さ (エディターの文字セル単位)。
  "minimap_tooltip_height": 6,

  //ミニマップ: "ツールチップパネル" の幅 (エディター幅に対する %)。
  "minimap_tooltip_width": 60,

  //ミニマップ: 値>2 の場合の、ミニマップのツールチップ専用のフォントサイズ。
  "minimap_tooltip_font_size": 0,

  //ミニマップ: Sublime Text 2 の機能 (Sublime Text 3 で削除):
  //ミニマップ上でマウスボタンを押すと、すぐに選択矩形のドラッグを開始します。
  //オフ (既定) の場合: ミニマップのクリックはスクロールのみ行います。
  "minimap_drag_immediately": false,

  //[View/Micromap]
  //マイクロマップ (右側の小さな縦バー、"行の状態" を表示) を表示します。
  "micromap_show": false,

  //マイクロマップを、独立した細いパネルではなく縦スクロールバー上に配置します。
  //注意: "scrollbar_arrows" オプションで縦スクロールバーの矢印を非表示にできます。
  "micromap_on_scrollbar": false,

  //マイクロマップに "行の状態" を表示します。
  "micromap_line_states": true,

  //マイクロマップにブックマークを表示します。
  "micromap_bookmarks": false,

  //[Text/VerticalLines]
  //すべてのカーソル位置に追加の縦線を表示します。
  "show_cur_column": false,

  //"margin" と呼ばれる縦線の位置。
  //"margin で折り返し" モードや一部のプラグインで使用されます。
  //この線を非表示にするには、2000 などの大きな値を設定します。
  //値<0: ウィンドウの右端からのインデントを意味します。
  "margin": 2000,

  //追加の縦線。
  //列位置のリスト (スペース区切り)。例: "60 80 100"。
  "margin_string": "",

  //[View/Unprinted]
  //不可視文字: 他の unprinted_ オプションをまとめて有効にするグローバルなフラグ。
  "unprinted_show": false,

  //不可視文字: 不可視文字として表示する情報。値は文字列です。
  //  値に "s" を含む場合: 空白を表示
  //  値に "x" を含む場合: 選択範囲内の空白のみ ("l", "t", "X" より優先)
  //  値に "X" を含む場合: 選択範囲内の空白も表示 ("l", "t" と併用)
  //  値に "l" を含む場合: 行頭と行末の空白のみ ("t" より優先)
  //  値に "t" を含む場合: 行末の空白のみ
  //  値に "T" を含む場合: すべてのタブ文字を強制的に表示 ("x", "X", "l", "t" より優先)
  //  値に "e" を含む場合: 行末マークを表示
  //  値に "p" を含む場合: 行末の矢印の代わりに段落記号を表示
  //  値に "." を含む場合: 行末の矢印の代わりに太い点を表示 ("p" より優先)
  //  値に "d" を含む場合: 詳細な行末マーク "LF", "CRLF", "CR" を表示 ("." より優先)
  //  値に "w" を含む場合: 折り返し行のマーク (ソフトラップ) を表示
  //注意: GUI ダイアログ "Options / Unprinted chars..." でこのオプションを変更できます。
  "unprinted_content": "se",

  //不可視文字: ASCII 制御文字 (コード 0..31) を代替文字に置き換えます。
  //オフの場合は、"xNN" 形式の16進コードで表示します。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "unprinted_replace_spec": false,

  //不可視文字: ASCII 文字 0...31 を、
  //指定した16進コードの "代替文字" として描画します。例: 値 "A4" は文字 U+00A4 を意味します。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "unprinted_replace_to_code": "A4",

  //不可視文字: タブ文字に描画する矢印の長さ。
  //値=1: 最小の長さ、0: フルサイズ。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "unprinted_tab_len": 1,

  //不可視文字: 各記号の大きさ (文字の高さに対する %)。
  //値はカンマ区切りの数値からなる文字列です:
  //- 空白文字の "点" の大きさ
  //- 行末の "点" の大きさ
  //- 行末のテキストマーク "LF", "CRLF", "CR", "EOF" の大きさ
  //- タブ文字の矢印の大きさ
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "unprinted_symbols_scale": "15,30,80,22,",

  //[Text/Wrap]
  //長い行の折り返しモード。
  //  0: 折り返さない (最速)
  //  1: ウィンドウ幅で折り返す (ウィンドウのサイズ変更で実際の値も変わります)
  //  2: ウィンドウ幅と "固定マージン" の小さい方で折り返す
  "wrap_mode": 0,

  //空白で始まる行では、折り返された部分も行自体と同じようにインデントして表示します。
  "wrap_indented": true,

  //行数がオプションの値より少ない場合にのみ、折り返し (ウィンドウ端、margin) を有効にします。
  //このオプションの理由: 折り返しを無効にする (None Lexer と併用) と、
  //巨大なファイルの読み込みが 1.5 倍速くなります。
  "wrap_enabled_max_lines": 60000,

  //[Text/Undo]
  //Undo: 元に戻せる 'アクション' の最大数。'アクション' とは:
  //- 単純なコマンド 1 回: 文字入力、Delete、BkSp、Enter、'行の削除'、'単語の削除' など;
  //- 複数カーソルでの編集 1 回 (カーソル数は "undo_max_carets" まで);
  //- 置換ダイアログでの 'すべて置換' 1 回
  "undo_limit": 5000,

  //Undo: 複数カーソルで編集していてカーソル数が多すぎる場合、
  //(速度低下を避けるため) Undo 情報をクリアします。
  "undo_max_carets": 4000,

  //Undo: コマンドをグループ単位で元に戻せるようにします。
  //(グループは、マウスクリックなどで区切られます。)
  "undo_grouped": true,

  //Undo: ファイル保存後も Undo を有効にします。
  "undo_after_save": true,

  //Undo: Undo データをディスクに保存するファイル (.cudatext サブフォルダー内のファイル)。
  //値には次を指定できます:
  //  - "": 機能を無効にする,
  //  - "*": すべてのファイルで有効にする,
  //  - "," 区切りのファイル拡張子 (例: "c,h,txt")。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  //注意: 次の場合はこのオプションを設定する必要はありません: a) 変更したファイルをセッションに保存していて、かつ
  //      b) "ui_history_disabled" に 'U' が含まれていない。
  "undo_persistent": "",

  //Undo: マウスクリックによるカーソル移動も Undo に記録します。
  //オンの場合、"元に戻す" コマンドを追加で実行しないと、
  //(クリックを行った場合) ファイルが "未変更" の状態に戻らないことがあります。
  "undo_mouse_clicks": false,

  //[Text/Caret]
  //行末より後ろにカーソルを置けるようにします (仮想カーソル位置)。
  //また、行頭で左矢印キーを押してもカーソルが前の行へ移動しなくなります。
  "caret_after_end": false,

  //カーソルの点滅間隔 (ミリ秒)。
  "caret_blink_time": 600,

  //カーソルの点滅を有効にします。
  "caret_blink_en": true,

  //複数カーソル (2 つ以上のカーソル) を有効にします。
  "caret_multi": true,

  //カーソルの形状は 2-3 個の値 (3 番目は省略可) をカンマ区切りで指定します: 幅,高さ,オプション。
  //- 幅: 値>0 ならピクセル、値<0 なら % 単位。
  //- 高さ: 値>0 ならピクセル、値<0 なら % 単位。100% を超えることもできます。
  //- オプション: 文字列に "_" を含む場合、カーソルの内側を空にします;
  //
  //カーソル: 通常時の形状。
  "caret_view": "2,-100",

  //...
  //カーソル: 上書き状態 (Ins キー: 挿入/上書き) の形状。
  "caret_view_ovr": "-100,-100",

  //...
  //カーソル: 読み取り専用モードの形状。
  "caret_view_ro": "-100,2",

  //カーソル: 列ブロックを貼り付けた後の位置。
  //  0: 変更しない
  //  1: 左下
  //  2: 右下
  //  3: 右上
  //  4: 左側にカーソルを縦に並べる
  //  5: 右側にカーソルを縦に並べる
  "caret_after_paste_column": 5,

  //カーソルを画面の表示領域内に保ちます。次のコマンドがこのオプションに従います:
  //"scroll line up/down", "scroll page up/down", "scroll to document begin/end" など。
  "caret_keep_visible_on_scroll": true,

  //列選択のモード。折り返された行や
  //全角 (CJK など) 文字を含む行で、値によって動作が変わります。"true" の場合は、
  //Sublime Text にかなり近い動作になります。"false" も便利で、一部の Windows のエディターを模倣します。
  "carets_primitive_column_sel": true,

  //値 N>0 の場合、上/下へスクロールするとき、エディターはカーソルから
  //上端/下端まで少なくとも N 行を保とうとします。カーソルが 1 つのときのみ有効です。
  //他のエディターでは 'scrollOff' や 'scrollOffset' として知られています。
  "caret_proximity_vert": 0,

  //[Find]
  //検索ダイアログ: アプリ起動時の表示方法。
  //  0: 表示しない
  //  1: "find" モードで表示
  //  2: "replace" モードで表示
  "find_show_on_start": 0,

  //検索ダイアログ: 検索ダイアログを (メインウィンドウにドッキングせず) 別ウィンドウで表示します。
  //このオプションはアプリの再起動後に適用されます。
  "find_separate_form": false,

  //検索ダイアログ: (最初のカーソルの) 選択範囲を検索文字列の初期値として提案します。
  "find_suggest_sel": true,

  //検索ダイアログ: (最初のカーソル位置の) 現在の単語を検索文字列の初期値として提案します。
  "find_suggest_cur_word": false,

  //検索ダイアログ: エディターにカーソルが 1 つで、複数行の選択範囲がある場合、
  //オプション "Search in selection" をオンにします。
  "find_suggest_in_selection": false,

  //コマンド "Find current selection next / previous": 大文字小文字の区別の状態。
  //  0: 区別しない
  //  1: 区別する
  //  2: 検索ダイアログのオプションを使用
  "find_sel_case": 2,

  //検索ダイアログ: 非表示にするボタン。
  //  値に 'R' を含む場合: "Regular expressions" オプションボタン
  //  値に 'S' を含む場合: "Case sensitive" オプションボタン
  //  値に 'W' を含む場合: "Whole words" オプションボタン
  //  値に 'O' を含む場合: "Wrapped search" オプションボタン
  //  値に 'I' を含む場合: "Search in selection" オプションボタン
  //  値に 'M' を含む場合: "Multi-line inputs" オプションボタン
  //  値に 'X' を含む場合: "Allowed syntax elements" オプションボタン
  //  値に 'H' を含む場合: "Highlight all matches" オプションボタン
  //  値に 'i' を含む場合: "Immediate search" オプションボタン
  //  値に 'C' を含む場合: "Confirm on replace" オプションボタン
  //  値に 'E' を含む場合: "RegEx substitution for 'Replace with'" オプションボタン
  //  値に 'P' を含む場合: "Preserve case on replacement" オプションボタン
  //  値に 'f' を含む場合: "Find first" ボタン
  //  値に 'n' を含む場合: "Find next" ボタン
  //  値に 'p' を含む場合: "Find prev" ボタン
  //  値に 'a' を含む場合: "Replace all" ボタン
  //  値に 'g' を含む場合: "Replace global" ボタン
  "find_hidden_buttons": "",

  //検索ダイアログ: 複数行モード: 入力欄の高さ (ボタンの高さに対する %)。
  "find_multiline_height": 250,

  //"Go to" や "Find" を実行して、新しい位置が現在の画面の外になる場合、
  //新しい位置から N 行分、縦にスクロールします。
  //  abs(N)>=100 のような大きな値 N: 縦方向に中央寄せします
  //  N<0: abs(N) は新しい位置の上端からのインデントです
  //  N>=0: N は上端 (上へ移動する場合) または下端 (下へ移動する場合) からのインデントです
  "find_indent_vert": -5,

  //"Go to" や "Find" を実行して、新しい位置が現在の画面の外になる場合、
  //新しい位置から N 文字分、横にスクロールします。値は 0 以上にしてください。
  "find_indent_horz": 10,

  //検索ダイアログのオプション "Highlight all matches": ドキュメント全体を処理する
  //最大行数。これより大きいドキュメントでは動作が変わります:
  //表示中のエディター領域にのみ
  //マークを付け、スクロール時にマークを更新します (エディターの動作が
  //大きく遅くなることはありません)。
  //このオプションは次の場合にも使われます: ドキュメントのサイズが option_value*50 を超えると、
  //検索ダイアログは 'immediate search' ('Im') オプションにタイマーを使用します。つまり、
  //'immediate search' はタイマーの刻みごとに次の一致箇所を検索します。
  "find_hi_max_lines": 4000,

  //検索ダイアログのオプション "Highlight all matches": 処理する最大の行長。
  //それより長い行の一致箇所はハイライトされません。
  //注意: 正規表現検索は影響を受けません。
  "find_hi_max_line_len": 800000,

  //検索ダイアログのオプション "Highlight all matches": 横スクロールバーの
  //最大幅 (平均文字数)。この幅以下であれば
  //"Highlight all matches" はドキュメント全体を処理します。これより広い場合は、
  //ドキュメントの表示領域内のみを検索します。
  "find_hi_max_columns": 400,

  //ドキュメントの行数がオプションの値より多い場合、"Highlight all matches" は
  //検索ダイアログでの入力時に即座にではなく、タイマーで動作します。
  "find_hi_timer_lines": 2000,

  //オプション "find_hi_timer_lines" で言及しているタイマーの間隔 (ミリ秒)。
  "find_hi_timer_interval": 500,

  //検索がドキュメントの端で (検索ダイアログのオプション "O" により) 通知なく折り返したとき、
  //検索ダイアログの入力欄を、指定した背景色で点滅させられます。値は
  //UI テーマ項目の ID (data/themes/*.cuda-theme-ui ファイルに記載されているもの) にしてください。
  //大文字小文字は区別しません。空または不正な文字列: 点滅は無効です。
  //この機能を有効にする値の良い例: "EdMarkedRangeBg"。
  "find_wrapped_blinking": "",

  //検索ダイアログ: 1 行モードで Ctrl+Enter ホットキー (改行の挿入) を有効にします。
  //複数行モードでは Ctrl+Enter は常に動作します。
  "find_ctrl_enter": true,

  //[UI]
  //UI の拡大率 (%)、70...500. [has suffix]
  //値=0: OS のスケーリングを検出して使用します (現在は Windows のみ)。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "ui_scale": 0,
  "ui_scale__linux": 0,
  "ui_scale__mac": 0,

  //すべてのフォントの拡大率 (%)、70...500. [has suffix]
  //値=0: オプション "ui_scale" に従います。
  //注意: Windows では 0 にしないでください。高 DPI でフォントが大きくなりすぎます。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "ui_scale_font": 100,
  "ui_scale_font__linux": 100,
  "ui_scale_font__mac": 100,

  //OS のダークモードに応じて、ライト/ダークテーマを自動で切り替えられるようにします。
  //ライト/ダークテーマの名前は "ui_theme_light" と "ui_theme_dark" で設定する必要があります。
  "ui_theme_auto_mode": false,

  //ライトテーマの名前 (オプション "ui_theme_auto_mode":true 用)。
  //空文字列は既定のライトテーマを意味します。
  //同じ名前の UI テーマと構文テーマの両方が必要です。
  "ui_theme_light": "syn",

  //ダークテーマの名前 (オプション "ui_theme_auto_mode":true 用)。
  //同じ名前の UI テーマと構文テーマの両方が必要です。
  "ui_theme_dark": "sub",

  //[UI/Tabs]
  //UI タブ: UI タブ全体の表示フラグ。'false' の場合、UI タブは非表示になります。
  "ui_tab_show": true,

  //UI タブ: Ctrl+Tab、Ctrl+Shift+Tab で "タブ切り替え" ダイアログを使用します。このダイアログは
  //タブを最近使った順に並べます。オフの場合: ダイアログなしでタブを切り替え、
  //最近使った順は無視します。
  "ui_tab_switcher_dialog": false,

  //UI タブ: シングルドキュメントインターフェイスを使用します (最初の 1 つ以外はタブを作成しません)。
  "ui_tab_disabled": false,

  //UI タブ: 可変幅のタブを使用します (幅はタブの見出しに依存)。
  "ui_tab_variable_width": false,

  //UI タブ: 複数行モードを許可します: タブが多い場合、
  //タブを複数行に折り返します。
  "ui_tab_multiline": false,

  //UI タブ: 左右の辺を斜めに表示します。
  //注意: 一部の OS/デスクトップでは斜めのタブの描画に問題があるため、
  //それを避けるため、このオプションは macOS と Linux Qt5 では無効です。
  "ui_tab_angled": false,

  //UI タブ: フラットな外観。
  "ui_tab_flat": false,

  //UI タブ: タブの左右にあるボタンの配置。
  //数文字の文字列で、各文字が 1 つのボタンを表します。左右の区切りはカンマで、
  //区切りは 1 つだけ指定できます。
  //使用できる文字 (ボタン):
  //  "<", ">" - スクロール矢印
  //  "v" - ドロップダウンメニューの矢印
  //  "+" - プラスボタン (プラス疑似タブと同じですが、タブが多くても隠れません)
  //  "x" - 閉じるボタン (アクティブなタブの x アイコンと同じ)
  "ui_tab_button_layout": "<>,v",

  //UI タブ: 既定のタブ幅。
  "ui_tab_size_x": 170,

  //UI タブ: タブの最小幅 (タブが多いときに使用)。
  "ui_tab_size_x_min": 40,

  //UI タブ: タブの最大幅。
  "ui_tab_size_x_max": 300,

  //UI タブ: 既定のタブの高さ。
  "ui_tab_size_y": 26,

  //UI タブ: タブの位置 (辺)。
  //  0: 上
  //  1: 下
  //  2: 左
  //  3: 右
  "ui_tab_position": 0,

  //UI タブ: タブの左端とテキスト先頭の間のインデント。
  "ui_tab_padding": 6,

  //UI タブ: タブの右端とテキスト末尾の間のインデント。
  "ui_tab_padding2": 6,

  //UI タブ: タブに "x" ボタンを表示するタイミング。
  //  0: 表示しない
  //  1: すべてのタブに表示
  //  2: アクティブなタブのみ表示
  //  3: マウスオーバーのタブのみ表示
  //  4: アクティブなタブとマウスオーバーのタブに表示
  "ui_tab_show_x": 1,

  //UI タブ: "x" ボタンのサイズ。
  "ui_tab_show_x_size": 14,

  //UI タブ: "x" マークを円で囲んで表示します (オフの場合は四角)。
  "ui_tab_x_rounded": true,

  //UI タブ: "+" 疑似タブを表示します (クリックすると新しいタブを作成)。
  "ui_tab_show_plus": true,

  //UI タブ: 機能 "Set tab color" でタブの高さ全体を着色します。
  "ui_tab_fullcolor": false,

  //UI タブ: UI タブのタイトルフォントの追加の拡大率 (%)。
  "ui_tab_font_scale": 100,

  //UI タブ: ダブルクリックでタブを閉じます。
  "ui_tab_2click_closes": false,

  //UI タブ: タブに番号を表示します。
  "ui_tab_numbers": false,

  //UI タブ: 新しいタブを現在アクティブなタブの隣に開きます。
  "ui_tab_new_near_current": false,

  //UI タブ: タブを閉じたとき、同じグループ内で最近アクティブだったタブをアクティブにします (true)、
  //または右隣のタブをアクティブにします (false)。
  "ui_tab_recent_on_close": false,

  //UI タブ: プレビュータブ (プロジェクトマネージャーのファイル項目を 1 回クリックして開いたタブ) のフォントスタイル。
  //  値に "b" を含む場合: 太字
  //  値に "i" を含む場合: イタリック
  //  値に "u" を含む場合: 下線
  //  値に "s" を含む場合: 取り消し線
  "ui_tab_preview_font_style": "iu",

  //[UI/Listbox]
  //リストボックス: メニュー状のダイアログ (コマンドパレットやプラグインなど) の幅。
  "ui_listbox_size_x": 450,

  //リストボックス: メニュー状のダイアログ (コマンドパレットやプラグインなど) の高さ。
  "ui_listbox_size_y": 300,

  //リストボックス: 自動補完リストボックスの幅 (ピクセル)。
  "ui_listbox_complete_size_x": 550,

  //リストボックス: 自動補完リストボックスの高さ (項目数)。
  "ui_listbox_complete_size_items": 12,

  //リストボックス: メニュー状のダイアログ (コマンドパレットやプラグインなど) であいまい検索を有効にします。
  //Wiki に "あいまい検索 (fuzzy search)" の説明があります。
  "ui_listbox_fuzzy": true,

  //[UI/History]
  //履歴: コンボボックスの履歴の最大項目数 (0..200)。
  "ui_max_history_edits": 20,

  //履歴: "最近使ったファイル" メニューの最大項目数 (0..50)。
  "ui_max_history_menu": 10,

  //履歴: "settings/files(OS_SUFFIX).json" の最大項目数 (0..400)。
  "ui_max_history_files": 25,

  //履歴: コマンド "Edit / Paste from history" 用に保存するクリップボード項目の最大数。
  //0 の場合: クリップボード履歴は保持されません。
  //大きな値の場合: "Paste from history" のすべての項目が画面に収まらないことがあります。
  "ui_max_history_clipboard": 15,

  //履歴: 履歴/セッション/ブックマークのファイルに保存する要素。
  //このオプションは履歴の保存にのみ影響し、読み込み時は無視されます。
  //値は文字列で、各文字が 1 つの要素の保存を無効にします。
  //  値に 't' を含む場合: ドキュメントのテキスト (変更済みのドキュメントで保存されます)
  //  値に 'c' を含む場合: カーソルの位置と選択範囲 (最初のカーソルのみ)
  //  値に 'h' を含む場合: カーソルの選択範囲のみ
  //  値に 'T' を含む場合: タブ幅と "タブ文字をスペースにする" 状態
  //  値に 's' を含む場合: 縦スクロール位置
  //  値に 'e' を含む場合: エンコード
  //  値に 'b' を含む場合: ブックマーク
  //  値に 'l' を含む場合: Lexer 名
  //  値に 'L' を含む場合: ガター: "line states" 列の表示状態
  //  値に 'w' を含む場合: 折り返しの状態
  //  値に 'M' を含む場合: ミニマップの表示状態
  //  値に 'm' を含む場合: マイクロマップの表示状態
  //  値に 'r' を含む場合: ルーラーの表示状態
  //  値に 'u' を含む場合: 不可視文字の表示状態
  //  値に 'n' を含む場合: ガター: "line numbers" 列の表示状態
  //  値に 'S' を含む場合: フォントの拡大率 (%)
  //  値に 'f' を含む場合: ガター: "folding" 列の表示状態 + 折りたたまれたブロックの一覧
  //  値に 'C' を含む場合: UI タブの見出しのカスタム色
  //  値に 'F' を含む場合: コードツリーのフィルター: 文字列と履歴
  //  値に 'i' を含む場合: UI タブの分割状態 (水平/垂直、サイズの %)
  //  値に 'I' を含む場合: 縦の "margin" 線の列
  //  値に 'U' を含む場合: Undo/Redo データ
  "ui_history_disabled": "",

  //[UI/Listbox]
  //コマンドパレットのダイアログ: 最後の 'フィルター文字列' を (現在のセッションのみ) 記憶します。
  "ui_cmdpalette_filter_keep": false,

  //[UI]
  //Esc キーでプログラムを閉じます。
  "ui_esc_close": false,

  //Esc キーでコンソールパネルを閉じます。
  "ui_esc_close_console": true,

  //Esc キーで検索/置換ダイアログを閉じます。
  "ui_esc_close_finder": true,

  //"アイドルタイマー" の間隔 (ミリ秒)。
  //このタイマーは、キーボード/マウス入力がしばらくない間に "刻み" ます。
  //メニューのホットキー/チェックマークの更新など、アプリ全体の処理を行います。
  "ui_timer_idle": 1000,

  //"ui_open_dir" のサブオプション。
  //次のマクロを使用できます:
  //  {AppDir} - CudaText の実行ファイルのフォルダーパス。
  //  {AppDrive} - (Windows のみ) CudaText の実行ファイルのドライブ文字。例: "D:"。
  "ui_initial_dir": "",

  //ファイルを開く/名前を付けて保存ダイアログの初期フォルダー。
  //文字を指定します。各文字がフォルダーを判定する 1 つの手順です。
  //  'p': プロジェクトを開いている場合: プロジェクトマネージャーで選択中のフォルダー。
  //  'q': プロジェクトを開いている場合: "projectname.cuda-proj" ファイルのフォルダー。
  //  'f': フォーカスのある UI タブのフォルダー (名前が付いている場合)。
  //  'l': ファイルを開く/名前を付けて保存ダイアログで最後に選択したフォルダー。
  //  'i': オプション "ui_initial_dir" の値 (空でない場合)。
  //  'h': OS のホームフォルダー。
  "ui_open_dir": "pflih",

  //[UI/Tree]
  //コードツリーのフォントサイズの追加の拡大率 (%)。
  "ui_tree_font_scale": 100,

  //コードツリーの選択をカーソル位置に同期します。つまり、カーソルが移動した後に、
  //対応するコードツリーのノードを選択します。
  "ui_tree_auto_sync": true,

  //テキスト変更後、コードツリーの作成を
  //開始するまでの遅延 (ミリ秒)。
  "ui_tree_time_fill": 2000,

  //アイコンを割り当てる Lexer (例: C#) について、コードツリーにアイコンを表示します。
  "ui_tree_icons": true,

  //コードツリーのアイコンテーマ。
  //フォルダーの場所: codetreeicons
  "ui_tree_theme": "default_16x16",

  //幅に収まらないコードツリーの項目にツールチップを表示します。
  "ui_tree_show_tooltips": true,

  //コードツリーのフィルター欄の配置。
  //  0: 欄を非表示
  //  1: 欄を上に表示
  //  2: 欄を下に表示
  "ui_tree_filter_layout": 1,

  //コードツリーにサブ Lexer のノードを表示します。
  //例: PHP 内の JavaScript など。
  //このオプションはアプリの再起動後に適用されます。
  "ui_tree_sublexers": false,

  //コードツリーの作成処理の最大時間 (ミリ秒)。
  //この制限を超えるとツリーノードは追加されず、代わりにダミーのノードだけが
  //追加されます: ">200ms, skipped 1500/2000"。
  "ui_tree_fill_max_time": 150,

  //作成後にコードツリーを完全に展開します。
  "ui_tree_unfold": false,

  //コードツリーのノードを並べ替えます。
  //このオプションは Lexer 別の設定用で、user.json の設定には使用しません。
  "codetree_sorted": false,

  //[Text/NewDocument]
  //新規の空ドキュメント: Lexer 名。
  "newdoc_lexer": "",

  //新規の空ドキュメント: エンコード名。
  //指定できる名前は Wiki に一覧があります:
  // https://wiki.freepascal.org/CudaText#Encodings
  //"cudatext -el" を実行しても、指定できる名前を表示できます。
  "newdoc_encoding": "utf8",

  //新規の空ドキュメント: 改行コード。
  //  0: 自動: Windows では CRLF、それ以外は LF
  //  1: LF
  //  2: CRLF
  //  3: CR
  "newdoc_ends": 0,

  //[Text/Indent]
  //Enter を押したとき、新しい行を (前の行と同じように) インデントします。
  "indent_auto": true,

  //自動インデントされる行 (Enter 時) の空白の構成方法。
  //  0: 前の行と同じインデント (スペースとタブが混在する場合あり)
  //  1: スペースのみ
  //  2: タブ+スペース
  //  3: タブのみ
  //  4: 前の行の閉じられていない最後の "(" の位置までスペースで
  "indent_kind": 0,

  //インデント/インデント解除コマンドのインデント量。
  //  N>0: インデントは N 個のスペース
  //  N<0: インデントは abs(N) 個のタブ
  //  N=0: インデントはオプション "tab_size" と "tab_spaces" に従う
  "indent_size": 0,

  //選択ブロックのいずれかの行がすでに先頭の列にある場合、
  //それ以上のインデント解除 (Shift+Tab) を行いません。
  "unindent_keeps_align": false,

  //複数行をインデントするとき、コマンド後に選択範囲を、対象となった行全体に広げます。
  //オフの場合、選択範囲は以前と同じ範囲がずれた状態になります。
  "indent_makes_whole_line_sel": false,

  //Enter による自動インデント: 行がこの正規表現に一致する場合、("tab_size" 分の) インデントを追加します。
  //このオプションは Lexer 別の設定用で、user.json の設定には使用しません。
  //正規表現は大文字小文字を区別します。
  //次のような状況では、このオプションは不要です:
  //    some_code{|}
  //ここでは、カーソルが対になった括弧の内側にあるとき、Enter の押下は
  //"indent_auto_rule" を設定していなくても特別に処理されます。
  "indent_auto_rule": "",

  //[Mouse]
  //テキストブロックのドラッグ&ドロップを有効にします。
  "mouse_drag_drop": true,

  //テキストブロックを別のグループへドラッグ&ドロップした後、移動先のエディターにフォーカスします。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "mouse_drag_drop_focus_target": true,

  //右クリックでカーソルを移動します (コンテキストメニューを表示する前に)。
  "mouse_rt_click_moves_caret": false,

  //ダブルクリックしてそのままドラッグすると、単語単位で選択します。
  "mouse_2click_drag_select_words": true,

  //中クリックの動作。
  //  0: なし
  //  1: スクロール: "円" の画像を表示し、その近くでマウスを動かすと自動スクロールします
  //  2: クリックした位置に貼り付け
  //  3: "Go to definition" コマンドを実行
  "mouse_middle_click": 1,

  //縦ブロックの選択 (Alt+ドラッグ) を有効にします。
  "mouse_column_selection": true,

  //ガターの行番号をクリックしたとき、行全体を選択します。
  "mouse_gutter_click_sel": true,

  //Ctrl+[マウスホイールの上/下] でテキストを拡大/縮小できるようにします。
  //オフの場合でも、コマンドパレットの
  //"current document font size: bigger/smaller" を使用できます。
  "mouse_wheel_zoom": true,

  //マウスホイールのスクロール速度、縦方向 (行数)。
  "mouse_wheel_speed_vert": 3,

  //マウスホイールのスクロール速度、横方向 (文字数)。
  "mouse_wheel_speed_horz": 10,

  //選択範囲をエディターの上端/下端の外へドラッグしたときのマウスのスクロール速度
  //(タイマーの 1 刻みあたりの行数)。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "mouse_scroll_speed_vert": 1,

  //"Go to definition" コマンドを、どの修飾キーを押しながらクリックして呼び出すか。
  //  "": 無効
  //  "a": Alt+クリック。注意: Linux では動作しない場合があります
  //  "c": Ctrl+クリック。有効な場合、カーソルの追加には Ctrl+[ホイールクリック] を使用します。他の複数選択の方法はすべて無効になります
  //  "ca": Ctrl+Alt+クリック
  //  "sa": Shift+Alt+クリック
  //  "sca": Shift+Ctrl+Alt+クリック
  "mouse_goto_definition": "ca",

  //行番号をマウスでクリック: 行末の改行を含めて行を選択
  //(そのため、カーソルは次の行に置かれます)。
  "mouse_click_number_selects_eol": true,

  //マウスでリンク (URL とメールアドレス) を開く方法。
  //(リンクはオプション "links_regex" で指定されます。)
  //  0: 開かない
  //  1: シングルクリックで開く
  //  2: ダブルクリックで開く
  "mouse_click_links": 2,

  //アプリが "mouse entered a hotspot area" イベントを発生させるまでの遅延 (ミリ秒)。このイベントは
  //LSP_Client や HTML-CSS-Markdown_Tooltips プラグインなどで使われます。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "mouse_hotspot_delay": 500,

  //[Keys]
  //BackSpace キー: カーソルがインデント領域内にある場合、インデント解除コマンドを実行します。
  "key_bksp_unindent": true,

  //BackSpace キー: カーソルが行頭にある場合、BkSp で前の行の末尾へ移動します。
  "key_bksp_wrap": true,

  //Tab キー: テキストが選択されている場合、インデントコマンドを実行します。
  "key_tab_indents_sel": true,

  //Home キー: 最初に行頭の空白以外の文字へ、次に行頭へジャンプします。
  "key_home_to_nonspace": true,

  //End キー: 最初に行末の空白以外の文字へ、次に行末へジャンプします。
  "key_end_to_nonspace": false,

  //Home/End キー: 折り返された長い行で移動するとき、折り返された部分を
  //別々の行として扱い、最初に折り返された部分の端へジャンプします。
  "key_home_end_nav_wrapped": true,

  //PageUp/PageDown キー: エディター上端からの相対位置を維持します。
  "key_page_keeps_rel_pos": true,

  //PageUp/PageDown キー: ページサイズ。
  //  0: 全体の高さ
  //  1: 全体の高さ - 1 行
  //  2: 高さの半分
  "key_page_size": 1,

  //上/下キー: カーソルの列を記憶/維持しようとします: 長い行から
  //短い行、再び長い行へ移動するとき。
  "key_up_down_keeps_column": true,

  //上/下キー: 折り返された長い行で移動するとき、折り返された部分を
  //別々の行として扱い、前の位置の上/下の位置へジャンプしようとします。
  "key_up_down_nav_wrapped": true,

  //上/下キー:
  //最初の行で上キーを押したとき - 先頭へジャンプします;
  //最終行で下キーを押したとき - 末尾へジャンプします。
  "key_up_down_allow_edge": true,

  //上/下キー: 選択範囲の反対側の端へジャンプしようとします。
  //値 true: Sublime Text 4 と同様、値 false: Notepad++ と同様。
  "key_up_down_swap_sel": true,

  //左/右矢印キー: "caret_after_end":false のとき、このオプションにより (カーソルが 2 つ以上ある場合)
  //カーソルが次/前の行へ移動できるようになります。
  //(a: カーソルが行頭にあって左矢印キーを押したとき、
  //b: カーソルが行末にあって右矢印キーを押したとき。)
  "key_left_right_wrap_with_carets": true,

  //左/右矢印キー: 選択範囲の反対側の端へジャンプしようとします。
  "key_left_right_swap_sel": true,

  //左/右矢印キー: 選択範囲の反対側の端へジャンプし、その選択を維持しようとします。
  //カーソルが 1 つのときのみ動作します。
  "key_left_right_swap_sel_and_select": false,

  //[UI/Statusbar]
  //CudaText には、選択の種類ごとに複数のオプションがあります。選択の種類:
  //  - 選択なし
  //  - 小さな選択 (カーソル 1 つ、選択が 1 行の一部)
  //  - ストリーム選択 (カーソル 1 つ、選択が 2 行以上にまたがる)
  //  - 列選択 (オプション "carets_primitive_column_sel":false の場合に使用)
  //  - 複数カーソル
  //オプション値で使用できるマクロ:
  //  {y}: 最初のカーソルの行インデックス
  //  {y2}: 最後のカーソルの行インデックス
  //  {yb}: 最初の選択範囲の開始位置の行インデックス
  //  {ye}: 最初の選択範囲の終了位置の行インデックス
  //  {x}: 最初のカーソルの列インデックス (タブ文字は 1 として数える)
  //  {xx}: 最後のカーソルの列インデックス (タブ文字は展開して数える)
  //  {count}: 総行数
  //  {carets}: カーソルの総数
  //  {sel}: 選択範囲に含まれる行数
  //  {selchars}: 選択されている文字数 (すべての種類の選択)
  //  {cols}: 列選択の列数
  //  {char}: 最初のカーソル位置の文字 (文字がない場合は空)
  //  {char_dec}: 最初のカーソル位置の文字の10進コード (文字がない場合は空)
  //  {char_hex}: 最初のカーソル位置の文字の2...4桁の16進コード (文字がない場合は空)
  //  {char_hex4}: 最初のカーソル位置の文字の4桁の16進コード (文字がない場合は空)
  //  {offset_max}: ドキュメントの総長 (UTF-16 文字数)
  //  {offset_caret}: 先頭から最初のカーソルまでのオフセット (UTF-16 文字数)
  //  {_ln}: ローカライズされた文字列 "Ln"
  //  {_col}: ローカライズされた文字列 "Col"
  //  {_sel}: ローカライズされた文字列 "sel"
  //  {_linesel}: ローカライズされた文字列 "lines sel"
  //  {_carets}: ローカライズされた文字列 "carets"
  //
  "ui_statusbar_no_sel": "{_ln} {y}, {_col} {xx}",
  "ui_statusbar_small_sel": "{_ln} {y}, {_col} {xx}, {_sel}",
  "ui_statusbar_str_sel": "{_ln} {y}, {_col} {xx}, {sel} {_linesel}",
  "ui_statusbar_col_sel": "{sel}x{cols} {_sel}",
  "ui_statusbar_carets": "{carets} {_carets}, {sel} {_linesel}",

  //ステータスバーを表示します。
  "ui_statusbar_show": true,

  //ステータスバーのパネル一覧。パネルを省略したり並べ替えたりできます。
  //パネルは "|" 区切りで、各項目は "," 区切りです: 名前, 配置, 幅。
  //パネル名:
  //    caret  : カーソル/選択範囲の情報。
  //    enc    : エンコード名。
  //    ends   : 改行コードの種類。
  //    lexer  : Lexer 名。
  //    tabsize: タブ文字の種類とサイズ。
  //    ins    : 挿入/上書きモード (Ins キーで切り替え)。
  //    selmode: 特殊な選択モード。指定できる文字列:
  //               "-" は通常の選択モード、
  //               "MouseCol" は Alt キーなしのマウスによる列選択、
  //               "KeybdCol" は Alt キーなしのキーボードによる列選択。
  //    ro     : 読み取り専用モードがオンのとき "RO"、それ以外は "-" を表示。
  //    wrap   : 折り返しモード。
  //             3 つのアイコンのいずれかを表示します: 折り返しなし、ウィンドウ端で折り返し、固定マージンで折り返し。
  //    zoom   : テキストの拡大率 (%)。
  //             この拡大率は、コマンドパレットのコマンド "current document font size: bigger/smaller" で変更できます。
  //             また Ctrl+<マウスホイール> でも変更できます (オプション "mouse_wheel_zoom":true の場合)。
  //    msg    : アプリやプラグインからの各種メッセージ。
  //パネルの配置:
  //    C: 中央
  //    L: 左
  //    R: 右
  //    A: 自動サイズ (幅はテキストに合わせる)
  "ui_statusbar_panels": "caret,C,180|enc,C,125|ends,A,|lexer,C,140|tabsize,A,|msg,L,",

  //ステータスバーのメッセージを指定した時間 (秒) 表示します。
  //その後、メッセージは灰色になります。
  "ui_statusbar_time": 5,

  //ステータスバーの最後のセルのツールチップの最大行数。
  //0 の場合: ツールチップは無効です。
  "ui_statusbar_hint_lines": 35,

  //[UI]
  //ウィンドウタイトルに表示する詳細情報。
  //値はオプション文字を含む文字列です。
  //  値に "p" を含む場合: ファイル名のみではなくフルパスを表示
  //  値に "s" を含む場合: {session_name} の部分を常に非表示
  //  値に "d" を含む場合: {default} の部分を非表示 (既定のセッションの場合のみ)
  //  値に "f" を含む場合: [f1] フローティンググループの表示を非表示
  //  値に "n" を含む場合: " - CudaText" を非表示
  "ui_title": "d",

  //コマンド "show function-hint" のヒントの待機時間。
  "ui_alt_hint_time": 9,

  //[UI/Sessions]
  //プログラム終了時に現在の "セッション" を保存し、起動時に復元します。
  //これにより、"Save tabs?" ダイアログに "Don't save / Keep in session" ボタンも表示されます。
  "ui_reopen_session": true,

  //コマンドラインでファイル/フォルダーが渡された場合でも、前回のセッションを復元できるようにします。
  //注意: 動作に問題が生じます: N 個のプログラムインスタンスが、同じ前回のセッションと
  //コマンドラインで渡されたファイルを再び開いてしまいます。
  "ui_reopen_session_cmdline": true,

  //値>0: "ui_reopen_session":true の場合、タイマーで現在のセッションを
  //指定した間隔 (秒) で保存します。
  //値<0: 常にタイマーで現在のセッションを、間隔=Abs(値) で保存します。
  //値=0: タイマーではセッションを保存しません。
  //注意: このタイマーはエディターの "アイドル状態"、つまりテキスト編集を
  //1-2 秒間止めたときにのみ動作します。
  "ui_session_save_interval": 40,

  //確認なしでプログラムを閉じ、変更済みのドキュメントを
  //セッションに保存できるようにします。詳細: a) "ui_auto_save_session":true、
  //b) "ui_reopen_session":true、
  //c) "ui_history_disabled" に "t" が含まれていない、の場合、
  //プログラムは終了時に確認なしで、変更済みのドキュメントをセッションに保存します。
  "ui_auto_save_session": true,

  //値 N>0 の場合、アプリはセッションファイルの N 個のバックアップ "filename.X.cuda-session" を作成します。
  //Session Manager プラグインで開くか、"default.cuda-session" にコピーできます。
  "ui_backup_sessions": 4,

  //セッションに保存できるドキュメント本文の最大サイズ (文字数)。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "ui_session_max_text": 50000000,

  //セッションに保存できる Undo データの最大サイズ。
  //Undo のサイズがこれより大きい場合、Undo はセッションに保存されませんが、エディター内では Undo は引き続き動作します。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "ui_session_max_undo": 1000000,

  //[Lexers]
  //構文テーマを Lexer のスタイルに適用できるようにします。
  //(また、ダイアログ "Lexer styles mapping" を自動表示します。)
  //true の場合: 現在の構文テーマが完全に使用され、Lexer に組み込まれたスタイル
  //(data/lexlib/*.lcf ファイル) を上書きします。false の場合: 構文テーマは使用されません
  //("SeparLine" などの特別なテーマ項目を除く)。
  //言い換えると、CudaText には 2 つの色のレイヤーがあります:
  //レイヤー 1: Lexer のスタイル - data/lexlib/*.lcf ファイル内。
  //レイヤー 2: 構文テーマ - data/themes/* ファイル内。
  //"ui_lexer_themes" が true の場合、レイヤー 2 がレイヤー 1 を上書きします。
  "ui_lexer_themes": true,

  //[View/Web]
  //HTML のカラーコード (例: #008080 / #0a0 / rgb(100, 0, 50)) に下線を引きます。
  //このオプションは Lexer 別の設定で使用してください。
  "underline_color": false,

  //HTML のカラーコードの描画方法:
  //  値<10: 指定した幅 (ピクセル) の下線を描画
  //  値=10: テキストの背景を着色
  //  値=11: テキストの背景を着色 (ただし関数の括弧の内側のみ)
  "underline_color_size": 3,

  //[View/Brackets]
  //対応する括弧を強調表示します。
  "bracket_highlight": true,

  //強調表示する括弧のペアを含む文字列 (順不同)。
  //次のペアに対応: () [] {} <>。
  "bracket_symbols": "()[]{}",

  //対応する括弧を検索する、カーソルからの最大距離 (行数)
  //(括弧の強調表示にのみ使用し、括弧へのジャンプには使用しません)。
  "bracket_distance": 150,

  //[File/Export]
  //HTML へのエクスポート: 出力に行番号を表示します。
  "export_html_numbers": false,

  //HTML へのエクスポート: HTML 出力のフォント名。
  //既定の空の値は、次のような標準的な名前が使われることを意味します:
  //Consolas,Monaco,Lucida Console,Liberation Mono,DejaVu Sans Mono,Bitstream Vera Sans Mono,Courier New,monospace
  "export_html_font_name": "",

  //HTML へのエクスポート: HTML 出力のフォントサイズ ("px" 単位)。
  "export_html_font_size": 12,

  //[Python]
  //Python エンジンのファイルパスを設定します. [has suffix]
  //複数の値を ";" 区切りで指定できます。
  //特別な値 "?": Python エンジンを完全に無効にします。
  //
  //オプションが正しければ、コンソールパネル (Ctrl+`) に Python のバージョンが表示されます
  //また、コンソールでコマンド "=sys.path" が動作します。
  //
  //Linux/*BSD で Python エンジンが自動検出されなかった場合の手順:
  //  1) ファイルマネージャーを開き、/usr に移動します
  //  2) "libpython3.*so*" を検索します
  //     ターミナルのコマンド:
  //     $ find /usr -name 'libpython3.*so*' 2>/dev/null
  //
  //  3) 見つからない場合は Python 3 をインストールして、手順 2 に戻ります
  //  4) user.json で、"pylib__linux" (または "pylib__freebsd" など) を、見つかったファイル名の
  //     いずれかに設定します。例:
  //     "pylib__linux" : "/usr/lib/x86_64-linux-gnu/libpython3.7m.so.1.0",
  //
  //macOS:
  //  Homebrew でインストールした Python は使用できません。
  //  www.python.org から Python をインストールしてください。そうすればアプリが Python を見つけます。
  //
  "pylib__linux": "libpython3.so",
  "pylib__mac": "/Library/Frameworks/Python.framework/Versions/3.9/lib/libpython3.9.dylib",
  "pylib__freebsd": "libpython3.6m.so",
  "pylib__haiku": "libpython3.10.so.1.0",

  //イベント "on_caret_slow" の Python API の遅延 (ミリ秒)。
  //カーソル移動に対する、対応する括弧の強調表示の反応速度にも影響します。
  "py_caret_slow": 100,

  //イベント "on_change_slow" の Python API の遅延 (ミリ秒)。
  //例: CudaLint プラグインで使用されます。
  "py_change_slow": 1500,

  //Python API のイベント "on_change_slow": イベント発生の最大間隔
  //(秒)。つまり、ユーザーが休まず入力し続けても、"on_change_slow" は
  //この間隔が経過した後に発生します。
  "py_change_slow_limit": 30,

  //[Text/Commands]
  //コメント化: 選択がない場合は、カーソルを次の行へ移動します。
  "comment_move_down": true,

  //コメント化: コメント化/コメント解除の後も、行内の文字位置を維持しようとします。
  "comment_save_column": false,

  //コメント化: 2 行以上選択している場合、共通する最大のインデント位置にコメントを挿入します。
  "comment_equal_column": false,

  //[Text/Completion]
  //data/autocomplete/*.acp ファイル (単語の固定リスト) からの自動補完を有効にします。
  //これらの *.acp ファイルは、少数の Lexer にしか存在しません。
  //この機能は古いため、"LSP Client" プラグインの使用をお勧めします。
  "autocomplete_acp": true,

  //HTML 専用の自動補完を有効にします。Wiki を参照してください。
  "autocomplete_html": true,

  //Lexer 名がこの正規表現に一致する場合、HTML 専用の自動補完を有効にします。
  "autocomplete_html_lexers": "HTML.*|\bPHP\b",

  //開始タグ <tagname> を入力した後に </tagname> を自動追加します。
  //また、"</" を入力したときに、最後に開いたタグを自動で閉じます。
  "autocomplete_html_autoclose": true,

  //CSS 専用の自動補完を有効にします。Wiki を参照してください。
  "autocomplete_css": true,

  //Lexer 名がこの正規表現に一致する場合、CSS 専用の自動補完を有効にします。
  "autocomplete_css_lexers": "CSS",

  //ファイルシステムを読み取る、file:/// URI 専用の自動補完を有効にします。
  "autocomplete_file_uri": true,

  //N 個の単語文字を入力した後に自動補完を自動表示します (0: 無効)。
  //このオプションは (主に) Lexer 別の設定用です。
  "autocomplete_autoshow_chars": 0,

  //自動補完の表示のきっかけとなる文字。
  //このオプションは (主に) Lexer 別の設定用です。
  //  例: 設定 "lexer Nnn.json" でオプションが "@!" の場合、@ と !
  //  の文字が Nnn Lexer で自動補完のきっかけになります。
  "autocomplete_trigger_chars": "",

  //補完リストボックスの表示中にこれらの文字のいずれかを入力すると、
  //リストボックスの項目が確定され、入力した文字も追加されます。
  //このオプションは (主に) Lexer 別の設定用です。
  "autocomplete_commit_chars": ",;",

  //Enter キーで自動補完の結果を確定できるようにします。
  //Tab キーは常に結果を確定します。
  "autocomplete_commit_on_enter": true,

  //補完リストボックスの表示中にこれらの文字のいずれかを入力すると、
  //リストボックスが閉じられ、入力した文字が追加されます。
  "autocomplete_close_chars": "<>()[]{}=",

  //選択した自動補完の項目に () がある場合、挿入時に "(" を追加します。
  "autocomplete_add_opening_bracket": true,

  //選択が一番上にある状態で上キーを押したとき、または一番下にある状態で
  //下キーを押したときの動作。
  //  0: 押したキーを無視
  //  1: 選択を反対側の端に移動
  //  2: 自動補完を閉じる
  "autocomplete_up_down_at_edge": 1,

  //補完リストボックスの項目が 1 つだけの場合、メニューを表示せずに確定します。
  "autocomplete_commit_single_item": false,

  //一致する単語がないときに、自動補完リストボックスを閉じるまでの遅延 (ミリ秒)。
  //値=0: リストボックスを即座に閉じます (ただし、LSP プラグインではちらつきが発生します。
  //LSP のリストボックスで左/右矢印キーを押したとき)。
  "autocomplete_closing_delay": 300,

  //false の場合、自動補完はカーソルの右側の直近の単語文字を置き換えません。
  "autocomplete_replace_on_right": true,

  //補完リストボックスの再表示を許可する、カーソルの前にある単語以外の文字。
  //このオプションは最初のリストボックスの表示ではなく、リストボックスの表示中に
  //ユーザーがカーソルを移動/文字を削除したときに有効です。この場合、リストボックスは再表示または非表示になります。
  //C++ の演算子 :: と -> のため、このオプションには少なくとも .:> の文字を含めてください。
  //引用符は必須ではありませんが、Codeium プラグインのためにあると便利です。
  "autocomplete_symbol_chars_allowed": ".:>'\"",

  //入力時に一部の文字を自動でペアにします。
  //値には、対応している文字のいくつかをスペースなしで指定します:
  //  ( [ { < ' " ` ~ * # “ ‘ «
  //(JSON ファイルでは "-文字をエスケープした形式にする必要があることに注意してください。)
  //バックスラッシュでエスケープされた文字には自動ペアは働きません。
  //カーソルの後ろが単語文字の場合、自動ペアは働きません。
  "auto_close_brackets": "([{\"",

  //[Text/Folding]
  //値>1 の場合、連続する N 行の 'コメント'/'文字列' の行から
  //折りたたみ範囲を自動的に作成します。
  //注意: このオプションはグローバルで、Lexer 別には設定できません。
  "auto_fold_comments": 0,

  //[View/Web]
  //ハイパーリンク (URL とメールアドレス) を強調表示して下線を引きます。
  //オプション "links_regex" に適切な正規表現が必要です。
  "links_hilite": true,

  //ハイパーリンクを検出する正規表現。
  //既定値は、http://、https://、ftp:// のリンクとメールアドレス ('mailto:' は省略可) を検出します。
  "links_regex": "\\b(mailto:)?\\w[\\w\\-\\+\\.]*@\\w[\\w\\-\\.]*\\.\\w{2,}\\b|\\b(https?://|ftp://)\\w[\\w\\-\\.@]*(:\\d+)?(/([~\\w\\.\\-\\+/%@!%:&\\*=\\|,;\\$\\[\\]]|\\(.*?\\)|\\{.*?\\})*)?(\\?[^\\s\"'<>]*[\\w/\\-\\+\\*=])?(\\#[\\w\\-\\./%:!]*)?",

  //[File]
  //開くことを許可する最大のファイルサイズ (MB)。
  //値は内部的に 2047 に制限されます。
  "ui_max_size_open": 500,

  //このサイズ以上のファイルを、読み取り専用のテキストビューアーで開きます (MB)。
  //値 0: 大きなファイル用のビューアーモードの自動切り替えを無効にします。
  "ui_large_file_viewer": 100,

  //Lexer の使用を許可する最大のファイルサイズ (MB)。
  //  JSON、XML では重要です: ファイルがこれより大きい場合、通常の Lexer の代わりに
  //  lite Lexer (JSON ^, XML ^) が使用されます。
  "ui_max_size_lexer": 2,

  //[UI]
  //全画面表示にしたとき、これらの UI 要素を非表示にします。
  //値は数文字からなる文字列です:
  //  値に "t" を含む場合: ツールバー
  //  値に "i" を含む場合: ステータスバー
  //  値に "a" を含む場合: サイドバー (通常は左側)
  //  値に "p" を含む場合: サイドバーの隣のサイドパネル (コードツリー、プロジェクトなど)
  //  値に "b" を含む場合: 下部パネル (コンソール、出力など)
  //  値に "u" を含む場合: ファイルのタブ
  //  値に "g" を含む場合: ガター (すべての列: 行番号、ブックマークなど)
  "ui_fullscreen": "t",

  //フォーカスのある入力欄の枠線を強調表示します。
  //検索/置換ダイアログ、コンソールパネル、コードツリーのフィルター入力に影響します。
  //  値=0: フォーカスのある入力欄を強調表示しません。
  //  値>0: フォーカスのある入力欄を、指定した枠線の幅 (ピクセル) で強調表示します。
  //  100 を加えると、メインエディター (とプラグインのエディター) でも強調表示します。
  //例: 値 102 は "枠線の幅=2 で強調表示し、メインエディターでも強調表示する" を意味します。
  "ui_active_border": 1,

  //パネル "Console" (サイドバーのボタンから呼び出せます): 折り返しモード。
  //パネル "Output" と "Validate" もこのオプションに従います。
  "ui_console_wrap": true,

  //[UI/Panels]
  //サイドバー (ボタンのある縦バー、通常は左側) を表示します。
  "ui_sidebar_show": true,

  //サイドバーを右側に配置します。
  "ui_sidebar_on_right": false,

  //サイドバーのアイコンテーマ。
  //フォルダーの場所: sideicons
  "ui_sidebar_theme": "common_20x20",

  //ツールバー (ボタンのある横バー、ウィンドウタイトルの下) を表示します。
  "ui_toolbar_show": false,

  //ツールバーのアイコンテーマ。
  //フォルダーの場所: toolbaricons
  "ui_toolbar_theme": "default_24x24",

  //メインメニューバーを表示します。
  //このオプションはアプリの再起動後に適用されます。
  "ui_menu_show": true,

  //上部のメニューバーにテーマを適用します (Windows のみ、他の OS では不可)。
  "ui_menu_themed": true,

  //テーマ付きの上部メニューバーのフォントサイズ (Windows のみ)。
  //注意: 大きすぎる値には対応していません: フォントがメニュー項目の領域にはみ出します。
  "ui_menu_themed_font_size": 9,

  //サイドバーの "上部メニューのコピー" ボタン (点が 3 つのアイコン) を表示するタイミング。
  //  0: 常に非表示
  //  1: 常に表示
  //  2: "ui_menu_show" の値に応じて自動で表示/非表示
  "ui_menu_button": 2,

  //プログラム起動時のサイドパネルの表示状態。
  //  0: 履歴ファイルから状態を復元
  //  1: 表示
  //  2: 非表示 (必要に応じてプログラムがパネルを表示)
  "ui_sidepanel_on_start": 0,

  //プログラム起動時の下部パネルの表示状態。
  //  0: 履歴ファイルから状態を復元
  //  1: 表示
  //  2: 非表示 (必要に応じてプログラムがパネルを表示)
  "ui_bottom_on_start": 0,

  //[Find/Hotkeys]
  //検索/置換ダイアログのホットキー。検索/置換ダイアログにフォーカスがあるときのみ動作します。
  //これらのホットキーは、コンボ (連続する 2 つのホットキー) にはできません。
  "find_hotkey_find_first": "Alt+Enter",
  "find_hotkey_find_prev": "Shift+Enter",
  "find_hotkey_replace_no_next": "Ctrl+Alt+Shift+Z",
  "find_hotkey_replace_all": "Ctrl+Alt+A",
  "find_hotkey_replace_global": "",
  "find_hotkey_count_all": "Ctrl+Alt+O",
  "find_hotkey_extract": "Ctrl+Alt+Q",
  "find_hotkey_select_all": "Ctrl+Alt+E",
  "find_hotkey_mark_all": "Ctrl+Alt+K",
  "find_hotkey_op_regex": "Ctrl+Alt+R",
  "find_hotkey_op_case": "Ctrl+Alt+C",
  "find_hotkey_op_words": "Ctrl+Alt+W",
  "find_hotkey_op_wrapped": "Ctrl+Alt+N",
  "find_hotkey_op_in_sel": "Ctrl+Alt+X",
  "find_hotkey_op_multiline": "Ctrl+Alt+M",
  "find_hotkey_op_confirm_rep": "Ctrl+Alt+Y",
  "find_hotkey_op_tokens": "",
  "find_hotkey_op_hi": "",
  "find_hotkey_op_im": "",
  "find_hotkey_op_prescase": "",
  "find_hotkey_more": "Ctrl+Alt+D",

  //[Viewer]
  //'バイナリ' モードでのビューアーのテキスト幅。
  "viewer_binary_width": 100,

  //ビューアーで、表示できない文字と ANSI の上位文字 0x7F...0xFF を表示します。
  "viewer_unprinted": false,

  //[Log]
  //プラグインの初期化に関する "Init: cuda_nnnn" の行をコンソールに表示します。
  "py_init_log": true,

  //コンソールの内容をファイル "settings/console.log" に書き込みます。
  "log_console": false,

  //"Loaded session...", "Saved session..." の行をコンソールに表示します。
  "log_sessions": true,

  //'描画時間' と '描画フレーム数' の赤いインジケーターを
  //画面の隅に表示します。CudaText の開発者向けです。
  "log_timing" : false,

  //[Emmet]
  //空のタグにスラッシュを追加します。
  //(結果の例: <img src="" />)
  "emmet_add_slash_to_empty_tags": true,

  //入れ子のタグにインデントを追加します。
  //(例: ul>li*6)
  "emmet_indent_nested": true,

  //class/id 属性を持つ略語 (例: .name) の場合、
  //結果の近くに HTML コメントを追加します。
  "emmet_comment_tags": false,

  //すべてを 1 行のコードに展開します。
  "emmet_single_line": false,

  //折り返された行から、"* "、"- "、"1." などの行マーカーを取り除きます。
  "emmet_trim_line_markers": true,

  //選択したテキストまたは Lorem Ipsum のテキスト (略語 p{@lorem}) を、
  //"margin" オプションで定義された列で折り返します。
  "emmet_word_wrap": false,

}
