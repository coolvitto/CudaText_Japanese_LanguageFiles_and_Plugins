msgid "Color Text: applied attribute to %d fragment(s)"
msgstr "Color Text: %d 個のフラグメントに属性を適用しました"

msgid "Color Text: applied attribute to fragment"
msgstr "Color Text: フラグメントに属性を適用しました"

msgid "Color Text: multi-carets are not supported"
msgstr "Color Text: マルチキャレットはサポートされていません"

msgid "Color Text: need a selection or caret on a word"
msgstr "Color Text: 選択範囲、または単語の上にキャレットが必要です"

msgid "Color Text: need a selection or option all_words=1"
msgstr "Color Text: 選択範囲、またはオプション all_words=1 が必要です"

msgid "Color Text: restored %d attribs for \"%s\""
msgstr "Color Text: \"%s\" の属性を %d 個復元しました"

msgid "Deleted %d attrib(s)"
msgstr "%d 個の属性を削除しました"

msgid "Need single caret"
msgstr "単一のキャレットが必要です"

msgid "No selection"
msgstr "選択範囲がありません"
