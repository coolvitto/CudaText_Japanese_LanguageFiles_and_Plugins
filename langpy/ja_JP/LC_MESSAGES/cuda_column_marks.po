msgid ""
"Additional margins (space separated).\n"
"Prefix with \"!\" to save permamently."
msgstr ""
"追加のマージン (スペース区切り)。\n"
"恒久的に保存するには先頭に \"!\" を付けてください。"

msgid "Cannot jump to mark"
msgstr "マークにジャンプできません"

msgid ""
"Fixed margin value.\n"
"Prefix with \"!\" to save permamently."
msgstr ""
"固定マージン値。\n"
"恒久的に保存するには先頭に \"!\" を付けてください。"

msgid "Jumped to column {}"
msgstr "列 {} にジャンプしました"

msgid "Need single caret"
msgstr "単一のキャレットが必要です"

msgid "Not valid list of integers: "
msgstr "有効な整数リストではありません: "

msgid "Wrong integer value: "
msgstr "不正な整数値です: "
